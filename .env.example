# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it holds live credentials.

# --- Site ------------------------------------------------------------------

# Public URL the app is served from (used for OG tags, QR codes, OAuth
# redirects, generated share links, ...). No trailing slash.
SITE_URL=http://localhost:3003

# Shown in the header, page titles and Discord embeds.
SITE_NAME=myhost

# Max upload size in bytes. 1610612736 = 1.5 GB.
MAX_UPLOAD_BYTES=1610612736

# Username that is automatically granted the "owner" role on every server
# start (bootstraps your first admin account after registering).
OWNER_USERNAME=admin

# --- Database (MySQL / MariaDB) --------------------------------------------
# The app creates and migrates all tables itself on first start - just point
# it at an empty database.

JINXMRCL_DB_HOST=127.0.0.1
JINXMRCL_DB_PORT=3306
JINXMRCL_DB_USER=jinxmrcl
JINXMRCL_DB_PASSWORD=change-me
JINXMRCL_DB_NAME=jinxmrcl

# --- Discord OAuth (optional) -----------------------------------------------
# Lets users sign in with Discord and shows their Discord presence on their
# profile. Leave blank to disable - the "Sign in with Discord" button will
# just fail gracefully if clicked. Create an application at
# https://discord.com/developers/applications and set its OAuth2 redirect
# to `${SITE_URL}/api/auth/discord/callback`.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Random secret used to encrypt stored Discord OAuth tokens at rest.
# Generate one with: openssl rand -hex 32
DISCORD_TOKEN_KEY=
